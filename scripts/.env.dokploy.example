# ─────────────────────────────────────────────────────────────
#  Dokploy Redeploy — configuration
#  Copy this file to scripts/.env.dokploy and fill in real values.
#
#  Steps:
#   1. Log into https://server.bootskills.com
#   2. Go to Profile Settings → API Keys → Create Token
#   3. Paste the token below
#   4. Run `scripts/deploy-dokploy.sh list` to see your application IDs
#   5. Fill DOKPLOY_APP_IDS with the apps you want to redeploy
# ─────────────────────────────────────────────────────────────

DOKPLOY_URL=https://server.bootskills.com
DOKPLOY_API_KEY=

# Comma-separated list of application IDs (from `list`)
# Example: DOKPLOY_APP_IDS=abc123xyz,def456uvw
DOKPLOY_APP_IDS=
