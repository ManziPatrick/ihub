# ============================================================
#  IHUB  —  Environment Variables for Coolify / Production
#  Copy this to .env and fill in your real values.
#  In Coolify: paste these keys into the "Environment Variables"
#  panel for the docker-compose service.
# ============================================================

# ─── PORTS (Coolify maps these automatically) ───────────────
BACKEND_PORT=4000
FRONTEND_PORT=8080

# ─── DATABASE ───────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ihub_db?retryWrites=true&w=majority

# ─── BACKUP DATABASE (Separate MongoDB cluster) ────────────────
BACKUP_MONGO_URI=mongodb+srv://<user>:<password>@<backup-cluster>.mongodb.net/ihub_backups?retryWrites=true&w=majority

# ─── AUTH / JWT ─────────────────────────────────────────────
JWT_SECRET=change_me_to_a_strong_random_secret
ACCESS_TOKEN_SECRET=change_me_access
REFRESH_TOKEN_SECRET=change_me_refresh
SESSION_SECRET=change_me_session
COOKIE_SECRET=change_me_cookie
COOKIE_DOMAIN=yourdomain.com

# ─── CORS / URLS ────────────────────────────────────────────
# The public URL where the backend API is reachable
BACKEND_URL=https://api.yourdomain.com
# The public URL where the frontend is reachable
CLIENT_URL=https://yourdomain.com
CLIENT_ORIGIN=https://yourdomain.com
CORS_ORIGIN=https://yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://api.yourdomain.com

# ─── AI SERVICES ────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...
HF_TOKEN=hf_...

# ─── STRIPE ─────────────────────────────────────────────────
STRIPE_PUBLIC_KEY=pk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
SUCCESS_PAYMENT_URL=https://yourdomain.com/success
CANCEL_PAYMENT_URL=https://yourdomain.com/cancel

# ─── GOOGLE / FIREBASE (Backend) ────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
FIREBASE_PROJECT_ID=your-firebase-project-id

# ─── EMAIL / SMTP ───────────────────────────────────────────
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=admin@yourdomain.com
SMTP_PASS=your_smtp_password
EMAIL_USER=admin@yourdomain.com
EMAIL_PASS=your_smtp_password
EMAIL_FROM=IHUB Academy <admin@yourdomain.com>
VERIFY_EMAIL_URL=https://yourdomain.com/signup

# ─── PUSHER ─────────────────────────────────────────────────
PUSHER_APP_ID=your_pusher_app_id
PUSHER_CLUSTER=your_cluster
PUSHER_KEY=your_pusher_key
PUSHER_SECRET=your_pusher_secret

# ─── CLOUDINARY ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── PAWAPAY (Multi-country Mobile Money) ──────────────────
# Bearer token from PawaPay dashboard → Developers → API Token
PAWAPAY_API_TOKEN=your_pawapay_bearer_jwt_token_here
# Also supports legacy Paypack OAuth2 (Rwanda only):
# PAYPACK_CLIENT_ID=your_paypack_client_id
# PAYPACK_CLIENT_SECRET=your_paypack_client_secret
# Webhook secret for callback signature verification
PAYPACK_WEBHOOK_SECRET=your_pawapay_webhook_secret
PAYPACK_ENVIRONMENT=production
PAYPACK_BASE_URL=https://api.pawapay.io

# ─── PESAPAL ────────────────────────────────────────────────
PESAPAL_CONSUMER_KEY=your_pesapal_consumer_key
PESAPAL_CONSUMER_SECRET=your_pesapal_consumer_secret
PESAPAL_ENVIRONMENT=production

# ─── FDI PAYMENTS ───────────────────────────────────────────
FDI_APP_ID=your_fdi_app_id
FDI_SECRET=your_fdi_secret
FDI_USE_LOCAL_MOCK=false

# ============================================================
#  FRONTEND  (VITE_* vars — injected at runtime)
# ============================================================

# API — must point to your public backend URL
VITE_API_URL=https://api.yourdomain.com/graphql
VITE_WS_URL=wss://api.yourdomain.com/graphql

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...

# Google OAuth
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_AUTH_REDIRECT_URL=/authgoogle
VITE_GOOGLE_CALLBACK_URL=/auth/google/callback

# Firebase (Frontend)
VITE_FIREBASE_API_KEY=AIza...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:abc123
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Stripe (Frontend — public key only)
VITE_STRIPE_PUBLIC_KEY=pk_live_...
VITE_STRIPE_SUCCESS_URL=/success
VITE_STRIPE_CANCEL_URL=/cancel

# Pusher (Frontend)
VITE_PUSHER_APP_ID=your_pusher_app_id
VITE_PUSHER_CLUSTER=your_cluster
VITE_PUSHER_KEY=your_pusher_key

# Cloudinary (Frontend)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_STRIPE=true
VITE_ENABLE_PUSHER=true
VITE_ENABLE_GOOGLE_AUTH=true
